    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "tsx": "^4.20.5",
    "typebox": "^1.3.27",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.5.2"
  }
}

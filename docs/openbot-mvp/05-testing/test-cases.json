      "forbidden_side_effects": "不得把 key 送到 worker",
      "evidence": "tests/e2e-local.test.ts",
      "mode": "automated"
    },
    {
      "id": "TC-INST-001",
      "req": "REQ-OPENBOT-008",
      "system": "install",
      "priority": "P0",
      "precondition": "npm 可用",
      "steps": ["npm install", "npm run build", "node dist/cli.js help"],

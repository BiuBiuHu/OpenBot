      "expected": "拒绝执行",
      "forbidden_side_effects": "不得对主机关机",
      "evidence": "tests/e2e-local.test.ts",
      "mode": "automated"
    },
    {
      "id": "TC-REMOTE-001",
      "req": "REQ-OPENBOT-003",
      "system": "worker",
      "priority": "P0",
      "precondition": "启动 worker.py",

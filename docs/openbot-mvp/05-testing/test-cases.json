      "forbidden_side_effects": "不得把失败显示为成功",
      "evidence": "integration-report.md",
      "mode": "conditional"
    },
    {
      "id": "TC-PERSIST-001",
      "req": "REQ-OPENBOT-002",
      "system": "worker",
      "priority": "P0",
      "precondition": "worker 已启动",
      "steps": ["创建 sleep job", "不关 worker 只停客户端轮询", "再 GET job"],
      "expected": "job 仍在磁盘/仍 running 或已完成",
      "forbidden_side_effects": "客户端退出不得 kill worker",
      "evidence": "tests/worker.test.ts",
      "mode": "automated"
    },
    {
      "id": "TC-DOC-001",
      "req": "REQ-OPENBOT-006",
      "system": "docs",

      "forbidden_side_effects": "postinstall 不得连用户主机",
      "evidence": "test-report.md",
      "mode": "automated"
    },
    {
      "id": "TC-BIND-001",
      "req": "REQ-OPENBOT-001",
      "system": "ssh",
      "priority": "P0",
      "precondition": "本机 sshd 或跳过",
      "steps": ["openbot init --host 127.0.0.1", "openbot bind"],

      "expected": "config 权限 0600；解析 .env 不把示例 key 当真实值除非设置",
      "forbidden_side_effects": "不得写入仓库 .env",
      "evidence": "tests/config.test.ts",
      "mode": "automated"
    },
    {
      "id": "TC-BYOK-001",
      "req": "REQ-OPENBOT-004",
      "system": "agent",
      "priority": "P0",
      "precondition": "清空 OPENAI_API_KEY",

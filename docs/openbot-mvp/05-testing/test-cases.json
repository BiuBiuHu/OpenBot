      "expected": "output 含当前 worker 主机内核；status succeeded",
      "forbidden_side_effects": "不得在无 worker 时伪造输出",
      "evidence": "tests/worker.test.ts",
      "mode": "automated"
    },
    {
      "id": "TC-CFG-001",
      "req": "REQ-OPENBOT-007",
      "system": "config",
      "priority": "P0",
      "precondition": "临时 OPENBOT_HOME",

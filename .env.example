# Copy to ~/.openbot/.env (preferred) or ./.env — never commit a filled copy.
# Used by the local control plane only. The remote worker does not receive this key.

# Required for chat. Direct `openbot run` works without a model key.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, Ollama, …)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional overrides. `openbot init` writes these into ~/.openbot/config.json instead.
# OPENBOT_HOST=203.0.113.10
# OPENBOT_USER=ubuntu
# OPENBOT_PORT=22
# OPENBOT_IDENTITY_FILE=~/.ssh/id_ed25519
# OPENBOT_CONTROL_PORT=3847
# OPENBOT_WORKER_PORT=3848

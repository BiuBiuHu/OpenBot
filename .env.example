# Copy to ~/.openbot/.env (preferred) or ./.env — never commit a filled copy.
# Used by the local control plane only. The remote worker does not receive this key.

# Required for chat. Direct `openbot run` works without a model key.
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, Ollama, …)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional overrides. `openbot init` writes these into ~/.openbot/config.json instead.
# OPENBOT_HOST=203.0.113.10
# OPENBOT_USER=ubuntu
# OPENBOT_PORT=22
# OPENBOT_IDENTITY_FILE=~/.ssh/id_ed25519
# OPENBOT_CONTROL_PORT=3847
# OPENBOT_WORKER_PORT=3848

# --- OpenHands Agent Server (v0 remote runtime, via local SSH tunnel) ---
# On the host the server listens on 127.0.0.1:8000 only. From this laptop:
#   ssh -L 127.0.0.1:8000:127.0.0.1:8000 user@host
# Then: npx openbot oh health
# Local client: docs/openbot-mvp/06-ops/local-client.md
# Trial / install: docs/openbot-mvp/06-ops/openhands-agent-server-trial.md
# Adapter: docs/openbot-mvp/06-ops/oh-runtime-adapter.md
OH_BASE_URL=http://127.0.0.1:8000
# Session key → header X-Session-API-Key. Never commit a filled copy.
OH_SESSION_API_KEY=
# Aliases: OPENHANDS_BASE_URL=  OPENHANDS_API_KEY=
# OPENHANDS_WORKSPACE=workspace/project
# Optional: model id / key the adapter sends when creating an OH conversation.
# If unset, create still works against a mock; a real Agent Server needs a host BYOK model.
# OPENHANDS_LLM_MODEL=
# OPENHANDS_LLM_API_KEY=
